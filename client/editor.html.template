er:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">窗口控制·滑动</button><button onclick="addKeyOfType('fullscreen')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Fullscreen Toggle</button><button onclick="addKeyOfType('dock')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Dock Panel</button><button onclick="addKeyOfType('switchprofile')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Switch Profile</button><button onclick="addKeyOfType('balance')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Deepseek Balance</button><button onclick="addKeyOfType('touchpad')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Touch Pad</button>
