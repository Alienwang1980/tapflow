<div id="macroModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:200;align-items:center;justify-content:center"><div style="background:var(--panel);padding:24px;border-radius:8px;border:1px solid var(--accent);width:520px"><h3>Macro Recorder</h3><p id="mkl" style="color:var(--dim);margin:8px 0"></p><div id="mtc" tabindex="0" onclick="this.focus()" style="min-height:44px;border:2px dashed var(--accent);outline:none;padding:8px;border-radius:4px;background:var(--bg);display:flex;flex-wrap:wrap;gap:4px;align-items:center"><span style="color:var(--dim);font-size:11px">Click here and type keys, or click modifiers...</span></div><div style="display:flex;gap:4px;margin:8px 0"><div style="display:flex;gap:4px;flex-wrap:wrap"><button onclick="addMT('LCOMMAND')" style="padding:5px 10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px">⌘L</button><button onclick="addMT('RCOMMAND')" style="padding:5px 10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px">⌘R</button><button onclick="addMT('LOPTION')" style="padding:5px 10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px">⌥L</button><button onclick="addMT('ROPTION')" style="padding:5px 10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px">⌥R</button><button onclick="addMT('LCONTROL')" style="padding:5px 10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px">⌃L</button><button onclick="addMT('RCONTROL')" style="padding:5px 10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px">⌃R</button><button onclick="addMT('LSHIFT')" style="padding:5px 10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px">⇧L</button><button onclick="addMT('RSHIFT')" style="padding:5px 10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px">⇧R</button><button onclick="addMT('FN')" style="padding:5px 10px;background:var(--card);color:var(--accent);border:1px solid var(--accent);border-radius:4px;cursor:pointer;font-size:11px">fn</button></div></div><div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px"><button onclick="closeMM()" style="padding:8px 16px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:4px;cursor:pointer">Cancel</button><button onclick="saveMacro()" style="padding:8px 16px;background:var(--green);color:#fff;border:none;border-radius:4px;cursor:pointer">Save</button></div></div></div>

<div id="textMacroModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:200;align-items:center;justify-content:center"><div style="background:var(--panel);padding:24px;border-radius:8px;border:1px solid var(--accent);width:520px"><h3 style="margin-bottom:4px">Text Macro Recorder</h3><p style="color:var(--dim);margin:4px 0;font-size:11px">Editing: <span id="tmModalKeyLabel">—</span></p><div id="tmModalPreview" style="margin:12px 0;padding:12px;background:var(--bg);border-radius:6px;border:2px solid var(--border);min-height:60px;max-height:200px;overflow-y:auto;font-family:monospace;font-size:14px;color:var(--text);white-space:pre-wrap;word-break:break-word">(empty)</div><div id="tmModalStatus" style="font-size:11px;color:var(--dim);margin-bottom:8px;min-height:18px"></div><div style="display:flex;gap:8px;margin-bottom:8px"><button id="tmBtnRecord" onclick="tmStartRecord()" style="flex:1;padding:10px;background:var(--accent);color:#1a1a1a;border:none;border-radius:6px;cursor:pointer;font-weight:600;font-size:13px">Record</button><button id="tmBtnClear" onclick="tmClearText()" style="padding:10px 16px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:13px">Clear</button></div><div style="display:flex;gap:8px;justify-content:flex-end"><button onclick="closeTextMacroModal(false)" style="padding:8px 16px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:4px;cursor:pointer">Cancel</button><button onclick="closeTextMacroModal(true)" style="padding:8px 16px;background:var(--green);color:#fff;border:none;border-radius:4px;cursor:pointer">Save</button></div></div></div>
