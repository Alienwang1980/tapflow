1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Win Shortcuts</button><button onclick="addKeyOfType('dock')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Dock Panel</button><button onclick="addKeyOfType('appmenu')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Dynamic Menu</button><button onclick="addKeyOfType('layoutpreset')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Layout Preset</button><button onclick="addKeyOfType('balance')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Deepseek Balance</button><button onclick="addKeyOfType('touchpad')" style="display:block;width:100%;margin:4px 0;padding:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;text-align:left">Touch Pad</button>
