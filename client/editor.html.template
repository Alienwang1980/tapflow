<div id="keyTypeModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;
background:rgba(0,0,0,0.6);z-index:200;align-items:center;justify-content:center">
<div style="background:var(--panel);padding:24px;border-radius:8px;border:1px solid var(--accent);min-width:280px">
