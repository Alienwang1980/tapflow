<div id="kbPicker" class="modal" onclick="if(event.target===this)closeKbPicker()" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:203;align-items:center;justify-content:center"><div class="mcard" style="background:var(--panel);padding:20px;border-radius:8px;border:1px solid var(--border);max-width:94vw;max-height:90vh;display:flex;flex-direction:column"><style>#kbPicker .kbk-sel{outline:2px solid var(--accent);background:#3a3050!important}#kbPicker .kbk:hover{outline:1px solid var(--accent)}</style><div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px"><h3 style="margin:0;color:var(--text);font-size:15px">Select Keyboard Key</h3><button onclick="closeKbPicker()" style="background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:4px;cursor:pointer;padding:4px 10px;font-size:12px">&#x2715;</button></div><div id="kbTabs" style="display:flex;gap:6px;margin-bottom:12px"></div><div id="kbLegend" style="display:flex;flex-wrap:wrap;margin-bottom:8px"></div><div id="kbBoard" style="overflow:auto;padding:4px;flex:1;min-height:220px"></div><div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px;align-items:center"><span id="kbSelInfo" style="flex:1;font-size:11px;color:var(--dim)">Click a key to select, click again to deselect</span><button id="kbBtnAll" onclick="confirmKbLayout()" style="padding:8px 16px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-weight:600">Drag Entire Keyboard</button><button id="kbBtnOne" onclick="confirmKbKey()" disabled style="padding:8px 16px;background:var(--accent);color:#1a1a1a;border:none;border-radius:4px;cursor:default;font-weight:600;opacity:0.4">Drag Selected Key Only</button><button onclick="closeKbPicker()" style="padding:8px 16px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:4px;cursor:pointer">Cancel</button></div></div></div>
<div id="unsavedModal" class="modal" onclick="if(event.target===this)unsavedCancel()" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:204;align-items:center;justify-content:center"><div class="mcard" style="background:var(--panel);padding:20px;border-radius:8px;border:1px solid var(--border);width:min(420px,90vw)"><h3 style="margin:0 0 8px;color:var(--text);font-size:15px">Unsaved Changes</h3><p style="margin:0 0 16px;font-size:13px;color:var(--dim)">This profile has unsaved changes. Save before switching?</p><div style="display:flex;gap:8px;justify-content:flex-end"><button onclick="unsavedGo(false)" style="padding:8px 14px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:12px">Don't Save</button><button onclick="unsavedCancel()" style="padding:8px 14px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:12px">Cancel</button><button onclick="unsavedGo(true)" style="padding:8px 16px;background:var(--accent);color:#1a1a1a;border:none;border-radius:4px;cursor:pointer;font-weight:600;font-size:12px">Save &amp; Switch</button></div></div></div>
<div id="wsConflictModal" class="modal" onclick="if(event.target===this)wsConflictKeep()" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:205;align-items:center;justify-content:center"><div class="mcard" style="background:var(--panel);padding:20px;border-radius:8px;border:1px solid var(--accent);width:min(440px,90vw)"><h3 style="margin:0 0 8px;color:var(--text);font-size:15px">Sync Conflict</h3><p style="margin:0 0 16px;font-size:13px;color:var(--dim)">The iPad synced an update to this profile, but you have unsaved changes. Keep your local changes, or discard them and take the remote version?</p><div style="display:flex;gap:8px;justify-content:flex-end"><button onclick="wsConflictKeep()" style="padding:8px 14px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:12px">Keep Local Changes</button><button onclick="wsConflictTake()" style="padding:8px 16px;background:var(--accent);color:#1a1a1a;border:none;border-radius:4px;cursor:pointer;font-weight:600;font-size:12px">Discard &amp; Take Remote</button></div></div></div>
</body></html>
