<div id="profileManagerModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:200;align-items:center;justify-content:center"><div style="background:var(--panel);padding:24px;border-radius:8px;border:1px solid var(--accent);width:420px"><h3 style="margin-bottom:16px">Manage Profiles</h3><div id="pmList"></div><div style="display:flex;gap:8px;justify-content:space-between;margin-top:16px"><button onclick="pmCreate()" style="padding:8px 16px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:12px;font-weight:500">+ New Profile</button><button onclick="document.getElementById('profileManagerModal').style.display='none'" style="padding:8px 16px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:6px;cursor:pointer;font-size:12px">Close</button></div></div></div>
<div id="macroModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:200;align-items:center;justify-content:center"><div style="background:var(--panel);padding:24px;border-radius:8px;border:1px solid var(--accent);width:440px"><h3>Macro Recorder</h3><p id="mkl" style="color:var(--dim);margin:8px 0"></p><div style="display:flex;gap:4px;margin:8px 0"><button id="mcb" onclick="setMM(1)" style="flex:1;padding:6px;border-radius:4px;cursor:pointer;background:var(--accent);color:#fff;border:none">Simul</button><button id="msq" onclick="setMM(2)" style="flex:1;padding:6px;border-radius:4px;cursor:pointer;background:var(--card);color:var(--text);border:1px solid var(--border)">Seq</button></div><div id="mtc" tabindex="0" onclick="this.focus()" style="min-height:44px;border:2px dashed var(--accent);outline:none;padding:8px;border-radius:4px;background:var(--bg);display:flex;flex-wrap:wrap;gap:4px;align-items:center"><span style="color:var(--dim);font-size:11px">Click here and type keys, or click modifiers...</span></div><div style="display:flex;gap:4px;margin:8px 0"><button onclick="addMT('COMMAND')" style="padding:6px 12px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer">Cmd</button><button onclick="addMT('OPTION')" style="padding:6px 12px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer">Opt</button><button onclick="addMT('CONTROL')" style="padding:6px 12px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer">Ctrl</button><button onclick="addMT('SHIFT')" style="padding:6px 12px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer">Shift</button></div><div style="display:flex;gap:8px;justify-content:flex-end;margin-top:12px"><button onclick="closeMM()" style="padding:8px 16px;background:transparent;color:var(--dim);border:1px solid var(--border);border-radius:4px;cursor:pointer">Cancel</button><button onclick="saveMacro()" style="padding:8px 16px;background:var(--green);color:#fff;border:none;border-radius:4px;cursor:pointer">Save</button></div></div></div>
