<!DOCTYPE html><html lang="zh-CN"><head>
<meta charset="UTF-8"><meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Tapflow — Editor</title>
<style>/* ==== STP Editor — Claude Warm ==== */
:root{
  --bg:#151210;--panel:#1e1b18;--card:#272421;--accent:#d97706;
  --text:#e8e0d8;--dim:#8b8078;--border:rgba(255,255,255,0.05);
  --success:#6b5c30;--danger:#5c3028;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--text)}
body{display:flex;flex-direction:column;user-select:none;-webkit-user-select:none}

/* ==== Toolbar ==== */
.tb{
  display:flex;align-items:center;gap:8px;padding:8px 16px;
  background:var(--panel);height:44px;flex-shrink:0;z-index:20;
}
.tb h1{font-size:14px;font-weight:600}
.tb h1 span{color:var(--accent);font-weight:400}
.tb .conn{font-size:10px;padding:2px 8px;border-radius:4px;font-weight:500}
.tb .conn.on{background:rgba(74,222,128,0.1);color:#4ade80}
.tb .conn.off{background:rgba(248,113,113,0.1);color:#f87171}
.tb select,.tb button{
  padding:5px 12px;border-radius:6px;border:1px solid var(--border);
  cursor:pointer;font-size:11px;background:var(--card);color:var(--text);
  font-weight:500;transition:all 0.15s;
}
.tb select:hover,.tb button:hover{border-color:var(--accent);background:#33302c}
.tb .btn-save{background:var(--success);border-color:var(--success);font-weight:600}
.tb .btn-save:hover{background:#7d6b3e}
.tb .btn-new{background:var(--card)}

/* ==== Layout ==== */
.main{display:flex;flex:1;overflow:hidden}

/* ==== Canvas ==== */
.carea{
  flex:1;position:relative;overflow:hidden;
  background:var(--bg);
  display:flex;align-items:center;justify-content:center;
  user-select:none;-webkit-user-select:none;min-width:0;
}
.cwrap{transform-origin:center center;position:relative;z-index:1}
.canvas{position:relative;background:transparent;border-radius:4px;border:1.5px solid rgba(255,255,255,0.12);}

/* ==== Frame Toolbar ==== */
.ftb{
  position:absolute;display:flex;align-items:center;gap:0;height:36px;
  z-index:30;pointer-events:auto;background:var(--panel);
  border:1px solid rgba(255,255,255,0.06);border-bottom:none;
  border-radius:8px 8px 0 0;
}
.ftb>*{pointer-events:auto}
.ftb select{
  height:36px;background:transparent;color:var(--text);
  border:none;padding:0 12px;font-size:11px;font-weight:600;cursor:pointer;
  min-width:90px;outline:none;
}
.ftb select:hover{background:rgba(255,255,255,0.03)}
.ftb .btn-ori{
  height:36px;background:transparent;color:var(--text);
  border:none;border-left:1px solid var(--border);padding:0 12px;
  font-size:14px;cursor:pointer;font-weight:600;transition:all 0.15s;
}
.ftb .btn-ori:hover{background:rgba(255,255,255,0.03);color:var(--accent)}
.ftb .ftb-sep{width:1px;height:20px;background:var(--border);margin:0 4px}
.ftb button{
  height:36px;background:transparent;color:var(--text);
  border:none;padding:0 10px;font-size:16px;cursor:pointer;font-weight:500;
  transition:all 0.15s;
}
.ftb button:hover{color:var(--accent);background:rgba(255,255,255,0.03)}
.ftb span{user-select:none}

/* ==== Keys ==== */
.ck{
  position:absolute;background:var(--card);border:2px solid transparent;
  border-radius:5px;display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:500;cursor:default;
  transition:border-color 0.1s,transform 0.06s,box-shadow 0.06s;
  user-select:none;overflow:visible;
}
.ck:hover{border-color:rgba(255,255,255,0.2)}

.ck.sel{border-color:var(--accent)!important;box-shadow:0 0 16px rgba(217,119,6,0.3)}
.ck .kl{pointer-events:none;text-align:center;line-height:1.2;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.ck .sz{position:absolute;top:2px;right:4px;font-size:8px;color:rgba(255,255,255,0.2);pointer-events:none}
.ck .rh{
  position:absolute;bottom:-4px;right:-4px;width:24px;height:24px;
  cursor:se-resize;opacity:0;pointer-events:none;
  background:linear-gradient(135deg,transparent 50%,rgba(255,255,255,0.2) 50%);
  border-radius:0 0 3px 0;z-index:2;
}
.ck:hover .rh,.ck.sel .rh{opacity:1;pointer-events:auto!important}
.ck.touchpad{border:2px solid rgba(255,255,255,0.06)}

#carea-overlay{position:absolute;inset:0;z-index:5;pointer-events:none;background:rgba(0,0,0,0.35)}
/* ==== Overlay Elements ==== */
.gh{position:absolute;border:1px dashed rgba(255,255,255,0.1);background:rgba(255,255,255,0.015);pointer-events:none;z-index:2;display:none}
.gt{position:absolute;color:rgba(255,255,255,0.25);font-size:10px;pointer-events:none;z-index:2;display:none;white-space:nowrap}
.sr{position:absolute;border:1px solid var(--accent);background:rgba(217,119,6,0.06);z-index:5;pointer-events:none;display:none}
.grh{position:absolute;width:10px;height:10px;background:var(--accent);border-radius:2px;z-index:6;cursor:pointer;display:none}
.grbox{position:absolute;border:2px dashed rgba(217,119,6,0.3);border-radius:2px;z-index:4;pointer-events:none;display:none}

/* ==== Right Panel ==== */
.rp{
  width:clamp(160px,20vw,270px);flex-shrink:1;min-width:0;background:var(--panel);z-index:15;
  overflow-y:auto;overflow-x:hidden;padding:0;
  box-shadow:-2px 0 24px rgba(0,0,0,0.5);
}
.rp-section{padding:12px}.clip-preview:hover{border-color:var(--accent)!important;background:#33302c}.clip-preview:active{cursor:grabbing}
.rp-divider{height:1px;background:var(--border);margin:0 12px}
.rp h3{font-size:12px;font-weight:600;margin-bottom:10px}
.rp label{display:block;font-size:10px;color:var(--dim);margin:10px 0 4px;font-weight:500}
.rp input,.rp select{
  width:100%;padding:6px 8px;background:var(--bg);color:var(--text);
  border:1px solid var(--border);border-radius:5px;font-size:11px;
  transition:border-color 0.15s;
}
.rp input:focus,.rp select:focus{border-color:var(--accent);outline:none}
.rp input[type=color]{width:30px;height:30px;padding:2px;border-radius:5px;cursor:pointer;background:var(--card);border:1px solid var(--border)}
.rp input[type=color]::-webkit-color-swatch-wrapper{padding:3px}
.rp input[type=color]::-webkit-color-swatch{border:none;border-radius:2px}
.rp input[type=number]::-webkit-outer-spin-button,
.rp input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.rp input[type=number]{-moz-appearance:textfield}
.rp .rw{display:flex;gap:8px}
.rp .rw>div{flex:1}
.rp .stepper{display:flex;align-items:center;gap:2px}
.rp .stepper button{
  width:28px;height:28px;font-size:16px;background:var(--card);color:var(--text);
  border:1px solid var(--border);border-radius:5px;cursor:pointer;
  transition:all 0.15s;font-weight:500;display:flex;align-items:center;justify-content:center;
}
.rp .stepper button:hover{border-color:var(--accent);background:#38332e}
.rp .stepper span{min-width:36px;text-align:center;font-size:12px;font-weight:600}
.rp .hint{font-size:9px;color:var(--dim);margin-top:2px}
.rp .br{display:flex;gap:8px;margin-top:12px}
.rp .br button{
  flex:1;padding:7px 12px;font-size:11px;cursor:pointer;
  border-radius:6px;font-weight:500;border:1px solid transparent;
  transition:all 0.15s;
}
.rp .btn-del{background:var(--danger);color:var(--text);font-weight:600}
.rp .btn-del:hover{background:#6d3830}

/* ==== List Items (Profiles/Pages/Groups) ==== */
.rp .it{
  padding:7px 10px;cursor:pointer;font-size:11px;
  display:flex;justify-content:space-between;align-items:center;
  color:var(--dim);transition:all 0.1s;border-radius:5px;margin:1px 0;
}
.rp .it:hover{background:rgba(255,255,255,0.04);color:var(--text)}
.rp .it.ac{
  border-left:2px solid var(--accent);background:rgba(217,119,6,0.06);
  color:var(--text);padding-left:8px;
}
.rp .it .x{
  opacity:0.6;color:var(--danger);cursor:pointer;font-size:14px;
  padding:2px 6px;border-radius:3px;transition:all 0.15s;
}
.rp .it .x:hover{opacity:1;background:var(--danger);color:var(--text)}
.rp .ar{display:flex;gap:4px;padding:4px 0}
.rp .ar input{
  flex:1;padding:5px 8px;background:var(--bg);color:var(--text);
  border:1px solid var(--border);border-radius:5px;font-size:10px;
}
.rp .ar input:focus{border-color:var(--accent);outline:none}
.rp .ar button{
  padding:5px 10px;font-size:10px;background:var(--card);color:var(--text);
  border:1px solid var(--border);border-radius:5px;cursor:pointer;font-weight:500;
}
.rp .ar button:hover{border-color:var(--accent)}

/* ==== Toast & Info ==== */
.toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
  background:var(--success);color:var(--text);padding:10px 24px;
  border-radius:8px;font-size:12px;font-weight:500;z-index:999;
  opacity:0;transition:opacity 0.3s;box-shadow:0 4px 24px rgba(0,0,0,0.5);
}
.toast.show{opacity:1}
.info{
  position:fixed;bottom:4px;left:4px;color:var(--dim);font-size:10px;
  z-index:999;background:var(--panel);padding:4px 8px;
  border-radius:4px;border:1px solid var(--border);
  user-select:text;-webkit-user-select:text;max-width:95vw;
}

@font-face{font-family:"Press Start 2P";src:url("/static/fonts/PressStart2P.woff2") format("woff2")}
@font-face{font-family:"VT323";src:url("/static/fonts/VT323.woff2") format("woff2")}
@font-face{font-family:"Russo One";src:url("/static/fonts/RussoOne.woff2") format("woff2")}

.btb{position:absolute;display:flex;align-items:center;gap:6px;height:34px;z-index:30;pointer-events:auto;background:var(--panel);border:1px solid rgba(255,255,255,0.06);border-radius:6px;padding:0 8px}
.btb>*{pointer-events:auto}
.btb button{height:28px;background:transparent;color:var(--text);border:none;padding:0 8px;font-size:14px;cursor:pointer;font-weight:500;transition:all 0.15s}
.btb button:hover{color:var(--accent)}
.btb span{font-size:11px;font-weight:600;min-width:24px;text-align:center;user-select:none}
#pmList button:hover{opacity:0.8}

.lib-item{padding:10px 12px;margin:6px 0;border-radius:8px;border:2px dashed var(--border);cursor:grab;background:var(--card);transition:all 0.15s}
.lib-item:hover{border-color:var(--accent);background:#33302c;transform:translateY(-1px)}
.lib-item:active{cursor:grabbing}
.lib-name{font-size:12px;font-weight:600;margin-bottom:1px}
.lib-desc{font-size:10px;color:var(--dim)}
</style></head>
<body>
<div class="tb">
  <h1>Smart <span>Touch</span> Editor</h1>
  <span class="conn off" id="cs">off</span>
  <button class="btn-save" onclick="saveProfile()">Save &amp; Sync</button>
  <button class="btn-new" onclick="saveAs()">Save As</button>
  <button class="btn-new" onclick="resetDefault()">Reset</button><button class="btn-new" onclick="copyStyle()">&#x2398; Copy Style</button><button class="btn-new" onclick="pasteStyle()">&#x2399; Paste Style</button>
</div>
<div class="main">
<div class="rp" id="lp-panel">
<div id="pl" style="display:none"></div>
      <div class="rp-section" id="rp-profiles-sec">
        <h3>Profiles <button onclick="pmCreate()" title="新建 Profile" style="font-size:10px;padding:2px 8px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;float:right;margin-left:4px">+ New</button><button onclick="pmImport()" title="从文件导入 Profile" style="font-size:10px;padding:2px 8px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;float:right;margin-left:4px">导入</button><button onclick="pmExportDialog()" title="导出 Profile" style="font-size:10px;padding:2px 8px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;float:right;margin-left:4px">导出</button></h3><input type="file" id="pmImpF" accept=".json,application/json" style="display:none" onchange="pmImportGo(this)">
        <div id="profList"></div>
      </div>
      <div class="rp-section">
        <h3 id="pp-heading">Profile Properties</h3>
        <div style="margin-top:6px"><div style="display:flex;align-items:center;gap:4px"><label style="font-size:10px;color:var(--dim);white-space:nowrap">Pat</label><select id="pagePat" onchange="upkPagePattern(this.value)" style="flex:1;height:22px;font-size:10px;padding:0 2px;background:var(--bg);color:var(--text);border:1px solid var(--border);border-radius:3px"><option value="none">No Pattern</option><option value="topography">Topography</option><option value="circuit">Circuit</option><option value="dots">Dots</option><option value="diagonal">Diagonal</option><option value="hexagon">Hexagon</option><option value="grid">Grid</option><option value="triangles">Triangles</option><option value="topo">Topography</option><option value="waves">Waves</option></select><button onclick="upkPagePatternSize(-10)" style="width:20px;height:22px;font-size:12px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:3px;cursor:pointer;line-height:1">-</button><span id="pagePatSz" style="font-size:10px;color:var(--dim);min-width:20px;text-align:center">60</span><button onclick="upkPagePatternSize(10)" style="width:20px;height:22px;font-size:12px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:3px;cursor:pointer;line-height:1">+</button></div><div style="margin-top:4px;display:flex;align-items:center;gap:6px"><label style="font-size:10px;color:var(--dim);white-space:nowrap">Pat Color</label><input type="color" id="pagePatColor" value="#ffffff" onchange="upkPagePatternColor(this.value)" style="width:30px;height:30px;padding:0;border:1px solid var(--border);border-radius:3px;cursor:pointer"></div>
        </div>
        <div style="margin-top:6px;display:flex;align-items:center;gap:6px"><label style="font-size:10px;color:var(--dim);white-space:nowrap">BG</label><input type="color" id="pageBg" value="#1a1a2e" onchange="upkPageBg(this.value)" style="width:30px;height:30px;padding:0;border:1px solid var(--border);border-radius:3px;cursor:pointer"></div>

      </div>
      <div class="rp-section" id="rp-ratio-sec">
        <h3>显示比例</h3>
        <div id="ratioInfo" style="font-size:10px;color:var(--dim);margin-bottom:6px">—</div>
        <div id="ratioBox" style="margin-top:0">
          <div id="ratioPresets" style="display:flex;flex-wrap:wrap;gap:4px"></div>
          <div style="display:flex;gap:4px;margin-top:6px">
            <button onclick="applyCustomRatio()" style="flex:1;padding:5px;font-size:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer">自定义像素…</button>
            <button onclick="toggleOri()" title="切换横竖屏" style="flex:1;padding:5px;font-size:10px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer">⟳ 横竖屏</button>
          </div>
        </div>
      </div>
      <div class="rp-section" id="rp-sound-sec">
        <h3>默认声音</h3>
        <div style="display:flex;gap:4px;align-items:center">
          <select id="tgs" onchange="if(profile){profile.defaultSound=this.value;dirty=true}"><option value="none">None</option><option value="click">Click</option><option value="soft">Soft</option><option value="mechanical">Mechanical</option><option value="deep">Deep</option><option value="red">Red Switch</option><option value="topre">Topre EC</option><option value="glass">Glass Tap</option><option value="bubble">Bubble Pop</option><option value="blip">8-bit Blip</option><option value="spark">Electric Spark</option></select>
          <button onclick="testSnd(document.getElementById('tgs').value)" style="padding:4px 8px;font-size:12px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;flex-shrink:0" title="Preview">&#x25B6;</button>
        </div>
      </div>
      <div class="rp-divider"></div>
      <div class="rp-section">
        <h3>Groups <button id="btnSaveGroup" onclick="saveAsGroup()" style="font-size:10px;padding:2px 8px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px;cursor:pointer;float:right">+ Group</button></h3>
        <div id="grpl"><p style="font-size:10px;color:var(--dim);padding:8px 0">No groups</p></div>
      </div>
      <div class="rp-divider"></div>
      <div id="rp-clipboard" class="rp-section">
        <h3>Clipboard</h3>
        <p style="font-size:10px;color:var(--dim);margin-bottom:8px">Select keys and click Copy</p>
        <div class="clip-preview" style="aspect-ratio:1;max-width:180px;background:var(--card);border-radius:6px;border:2px dashed var(--border);display:flex;align-items:center;justify-content:center;margin-bottom:8px;transition:all 0.15s"></div>
        <button onclick="_copyToClipboard()" style="width:100%;padding:6px 12px;border-radius:6px;border:1px solid var(--accent);background:rgba(217,119,6,0.15);color:var(--accent);cursor:pointer;font-size:11px;font-weight:600">Copy Selected</button>
      </div>
</div>
<div class="carea" id="carea"><div id="tl" style="position:absolute;inset:0;pointer-events:none;z-index:0;display:none"></div>
  <div class="gh" id="gh"></div>
  <div class="sr" id="sr"></div><div class="grh" id="grh_b" style="cursor:s-resize"></div><div class="grh" id="grh_l" style="cursor:w-resize"></div><div class="grh" id="grh_r" style="cursor:e-resize"></div>
  <div class="cwrap" id="cwrap"><div class="canvas" id="canvas"></div></div>
  <div id="carea-overlay"></div>
  <div class="btb" id="btb"><button onclick="zoomBy(-1)">−</button><button onclick="zoomBy(1)">+</button><span class="tb-sep">|</span><button onclick="fitAll()" title="Fit to frame">Fit</button><span class="tb-sep">|</span><button onclick="toggleFS()" title="Fullscreen">⛶</button><span class="tb-sep">|</span><button onclick="undo()" title="Undo">↩</button><button onclick="redo()" title="Redo">↪</button></div>
</div>
<div class="rp">
    
    
    <div id="rp-library" class="rp-section">
        <h3>Button Library</h3>
        <p style="font-size:10px;color:var(--dim);margin-bottom:10px">Drag to canvas</p>
        <div class="lib-item" draggable="true" data-widget="key">
          <div class="lib-preview" style="height:56px;display:flex;align-items:center;justify-content:center;margin-bottom:8px"><img src="/static/thumbnails/key.png" width="120" height="56" style="display:block;border-radius:4px"></div>
          <div class="lib-name">Regular Key</div>
          <div class="lib-desc">Press / Hold</div>
        </div>
        <div class="lib-item" draggable="true" data-widget="volume">
          <div class="lib-preview" style="height:56px;display:flex;align-items:center;justify-content:center;margin-bottom:8px"><img src="/static/thumbnails/volume.png" width="120" height="56" style="display:block;border-radius:4px"></div>
          <div class="lib-name">Volume Slider</div>
          <div class="lib-desc">2x1 . System volume control</div>
        </div>
        
        <div class="lib-item" draggable="true" data-widget="micmute">
          <div class="lib-preview" style="height:56px;display:flex;align-items:center;justify-content:center;margin-bottom:8px"><img src="/static/thumbnails/micmute.png" width="120" height="56" style="display:block;border-radius:4px"></div>
          <div class="lib-name">Mic Mute</div>
          <div class="lib-desc">1x1 . Mic mute toggle</div>
        </div>
        <div class="lib-item" draggable="true" data-widget="audioout">
          <div class="lib-preview" style="height:56px;display:flex;align-items:center;justify-content:center;margin-bottom:8px"><img src="/static/thumbnails/audioout.png" width="120" height="56" style="display:block;border-radius:4px"></div>
          <div class="lib-name">Audio Output</div>
          <div class="lib-desc">3x1 . Switch output device</div>
        </div>
        <div class="lib-item" draggable="true" data-widget="audioin">
          <div class="lib-preview" style="height:56px;display:flex;align-items:center;justify-content:center;margin-bottom:8px"><img src="/static/thumbnails/audioin.png" width="120" height="56" style="display:block;border-radius:4px"></div>
          <div class="lib-name">Audio Input</div>
          <div class="lib-desc">3x1 . Switch input device</div>
        </div>
        <div class="lib-item" draggable="true" data-widget="activeapp">
          <div class="lib-preview" style="height:56px;display:flex;align-items:center;justify-content:center;margin-bottom:8px"><img src="/static/thumbnails/activeapp.png" width="120" height="56" style="display:block;border-radius:4px"></div>
          <div class="lib-name">Window Switcher</div>
          <div class="lib-desc">3x1 . Tap to cycle windows</div>
        </div>
        <div class="lib-item" draggable="true" data-widget="winshortcuts">
          <div class="lib-preview" style="height:56px;display:flex;align-items:center;justify-content:center;margin-bottom:8px"><img src="/static/thumbnails/winshortcuts.png" width="120" height="56" style="display:block;border-radius:4px"></div>
          <div class="lib-name">Win Shortcuts</div>
          <div class="lib-desc">4x2 . Full/Min/MC/Desktop</div>
        </div>
        <div class="lib-item" draggable="true" data-widget="fullscreen">
          <div class="lib-preview" style="height:56px;display:flex;align-items:center;justify-content:center;margin-bottom:8px"><img src="/static/thumbnails/fullscreen.png" width="120" height="56" style="display:block;border-radius:4px"></div>
          <div class="lib-name">Fullscreen Toggle</div>
          <div class="lib-desc">1x1 . Toggle fullscreen</div>
        </div>
