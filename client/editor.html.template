<!DOCTYPE html><html lang="zh-CN"><head>
<meta charset="UTF-8"><meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Tapflow — Editor</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%231a1a2e'/%3E%3Ccircle cx='32' cy='32' r='15' fill='%234ade80'/%3E%3C/svg%3E">
<script src="/static/icons.js"></script>
<style>/* ==== Tapflow Editor — Claude Warm ==== */
:root{
  --bg:#151210;--panel:#1e1b18;--card:#272421;--accent:#d97706;
  --text:#e8e0d8;--dim:#8b8078;--border:rgba(255,255,255,0.05);
  --success:#6b5c30;--danger:#5c3028;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--text)}
body{display:flex;flex-direction:column;user-select:none;-webkit-user-select:none}

/* ==== Toolbar ==== */
.rp-topbar{
  display:flex;flex-direction:column;gap:8px;padding:10px 12px;
  background:var(--panel);border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:20;flex-shrink:0;
}
.rp-topbar .rp-trow{display:flex;align-items:center;gap:8px}
.rp-topbar .rp-trow svg{flex:none}
.rp-topbar h1{font-size:14px;font-weight:600;margin:0;flex:1}
.rp-topbar .conn{font-size:10px;padding:2px 8px;border-radius:4px;font-weight:500}
.rp-topbar .conn.on{background:rgba(74,222,128,0.1);color:#4ade80}
.rp-topbar .conn.off{background:rgba(248,113,113,0.1);color:#f87171}
.rp-topbar .btn-save{
  width:100%;padding:5px 12px;border-radius:6px;border:1px solid var(--success);
  cursor:pointer;font-size:11px;background:var(--success);color:var(--text);
  font-weight:600;transition:all 0.15s;
}
.rp-topbar .btn-save:hover{background:#7d6b3e}
.rp-topbar .btn-save.dirty{background:#7d6b3e;border-color:var(--accent);box-shadow:0 0 10px rgba(217,119,6,0.25)}
.rp-topbar .btn-save:disabled{opacity:0.45;cursor:default}
.rp-topbar .btn-save:disabled:hover{background:var(--success)}

/* ==== Layout ==== */
.main{display:flex;flex:1;overflow:hidden}

/* ==== Canvas ==== */
.carea{
  flex:1;position:relative;overflow:hidden;
  background:var(--bg);
  display:flex;align-items:center;justify-content:center;
  user-select:none;-webkit-user-select:none;min-width:0;
}
.cwrap{transform-origin:center center;position:relative;z-index:1}
.canvas{position:relative;background:transparent;border-radius:4px;border:1.5px solid rgba(255,255,255,0.12);}

/* ==== Frame Toolbar ==== */
.ftb{
  position:absolute;display:flex;align-items:center;gap:0;height:36px;
  z-index:30;pointer-events:auto;background:var(--panel);
  border:1px solid rgba(255,255,255,0.06);border-bottom:none;
  border-radius:8px 8px 0 0;
}
.ftb>*{pointer-events:auto}
.ftb select{
  height:36px;background:transparent;color:var(--text);
  border:none;padding:0 12px;font-size:11px;font-weight:600;cursor:pointer;
  min-width:90px;outline:none;
}
.ftb select:hover{background:rgba(255,255,255,0.03)}
.ftb .btn-ori{
  height:36px;background:transparent;color:var(--text);
  border:none;border-left:1px solid var(--border);padding:0 12px;
  font-size:14px;cursor:pointer;font-weight:600;transition:all 0.15s;
}
.ftb .btn-ori:hover{background:rgba(255,255,255,0.03);color:var(--accent)}
.ftb .ftb-sep{width:1px;height:20px;background:var(--border);margin:0 4px}
.ftb button{
  height:36px;background:transparent;color:var(--text);
  border:none;padding:0 10px;font-size:16px;cursor:pointer;font-weight:500;
  transition:all 0.15s;
}
.ftb button:hover{color:var(--accent);background:rgba(255,255,255,0.03)}
.ftb span{user-select:none}

/* ==== Keys ==== */
.ck{
  position:absolute;background:var(--card);border:2px solid transparent;
  border-radius:5px;display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:500;cursor:default;
  transition:border-color 0.1s,transform 0.06s,box-shadow 0.06s;
  user-select:none;overflow:visible;
}
.ck:not(.grp):hover{border-color:rgba(255,255,255,0.2)}

.ck.sel{border-color:var(--accent)!important;box-shadow:0 0 16px rgba(217,119,6,0.3)}
.ck.sd-drop{outline:2px solid var(--accent);outline-offset:-2px;box-shadow:0 0 12px rgba(96,165,250,0.45)}
.ck .kl{pointer-events:none;text-align:center;line-height:1.2;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.ck .sz{position:absolute;top:2px;right:4px;font-size:8px;color:rgba(255,255,255,0.2);pointer-events:none}
.sd-badge{display:none;position:absolute;bottom:0;left:0;right:0;padding:1px 2px;text-align:center;line-height:1.1;background:rgba(0,0,0,0.55);border-radius:0 0 13px 13px;pointer-events:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;z-index:4}
.sd-badge.sd-inh{opacity:0.75;font-style:italic}
.carea.sound-edit .sd-badge{display:block}
#sePanel{display:none}
#lp-panel.sound-edit > *:not(#sePanel){display:none}
#lp-panel.sound-edit #sePanel{display:flex}
.se-item{display:flex;align-items:center;gap:8px;padding:7px 9px;background:var(--card);border:1px solid var(--border);border-radius:6px;cursor:grab;user-select:none;-webkit-user-select:none}
.se-item:hover{border-color:var(--accent)}
.se-item:active{cursor:grabbing}
.ck .rh{
  position:absolute;bottom:-4px;right:-4px;width:24px;height:24px;
  cursor:se-resize;opacity:0;pointer-events:none;
  background:linear-gradient(135deg,transparent 50%,rgba(255,255,255,0.2) 50%);
  border-radius:0 0 3px 0;z-index:2;
}
.ck:not(.grp):hover .rh,.ck.sel:not(.grp) .rh,.ck.solo .rh{opacity:1;pointer-events:auto!important}
.ck.touchpad{border:2px solid rgba(255,255,255,0.06)}

#carea-overlay{position:absolute;inset:0;z-index:5;pointer-events:none;background:rgba(0,0,0,0.35)}
/* ==== Overlay Elements ==== */
.gh{position:absolute;border:1px dashed rgba(255,255,255,0.1);background:rgba(255,255,255,0.015);pointer-events:none;z-index:2;display:none}
.gt{position:absolute;color:rgba(255,255,255,0.25);font-size:10px;pointer-events:none;z-index:2;display:none;white-space:nowrap}
.sr{position:absolute;border:1px solid var(--accent);background:rgba(217,119,6,0.06);z-index:5;pointer-events:none;display:none}
.grh{position:absolute;width:10px;height:10px;background:var(--accent);border-radius:2px;z-index:6;cursor:pointer;display:none}
.grbox{position:absolute;border:2px dashed rgba(217,119,6,0.3);border-radius:2px;z-index:4;pointer-events:none;display:none}

/* ==== Right Panel ==== */
.rp{
  width:clamp(160px,20vw,270px);flex-shrink:1;min-width:0;background:var(--panel);z-index:15;
  overflow-y:auto;overflow-x:hidden;padding:0;
  box-shadow:-2px 0 24px rgba(0,0,0,0.5);
}
.rp-section{padding:12px}.clip-preview:hover{border-color:var(--accent)!important;background:#33302c}.clip-preview:active{cursor:grabbing}
.rp-divider{height:1px;background:var(--border);margin:0 12px}
.rp h3{font-size:12px;font-weight:600;margin-bottom:10px}
.rp label{display:block;font-size:10px;color:var(--dim);margin:10px 0 4px;font-weight:500}
.rp input,.rp select{
  width:100%;padding:6px 8px;background:var(--bg);color:var(--text);
  border:1px solid var(--border);border-radius:5px;font-size:11px;
  transition:border-color 0.15s;
}
.rp input:focus,.rp select:focus{border-color:var(--accent);outline:none}
.rp input[type=color]{width:30px;height:30px;padding:2px;border-radius:5px;cursor:pointer;background:var(--card);border:1px solid var(--border)}
.rp input[type=color]::-webkit-color-swatch-wrapper{padding:3px}
.rp input[type=color]::-webkit-color-swatch{border:none;border-radius:2px}
.rp input[type=number]::-webkit-outer-spin-button,
.rp input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.rp input[type=number]{-moz-appearance:textfield}
.rp .rw{display:flex;gap:8px}
.rp .rw>div{flex:1}
.rp .stepper{display:flex;align-items:center;gap:2px}
.rp .stepper button{
  width:28px;height:28px;font-size:16px;background:var(--card);color:var(--text);
  border:1px solid var(--border);border-radius:5px;cursor:pointer;
  transition:all 0.15s;font-weight:500;display:flex;align-items:center;justify-content:center;
}
.rp .stepper button:hover{border-color:var(--accent);background:#38332e}
.rp .stepper span{min-width:36px;text-align:center;font-size:12px;font-weight:600}
.rp .hint{font-size:9px;color:var(--dim);margin-top:2px}
.rp .br{display:flex;gap:8px;margin-top:12px}
.rp .br button{
  flex:1;padding:7px 12px;font-size:11px;cursor:pointer;
  border-radius:6px;font-weight:500;border:1px solid transparent;
  transition:all 0.15s;
}
.rp .btn-del{background:var(--danger);color:var(--text);font-weight:600}
.rp .btn-del:hover{background:#6d3830}

/* ==== List Items (Profiles/Pages/Groups) ==== */
.rp .it{
  padding:7px 10px;cursor:pointer;font-size:11px;
  display:flex;justify-content:space-between;align-items:center;
  color:var(--dim);transition:all 0.1s;border-radius:5px;margin:1px 0;
}
.rp .it:hover{background:rgba(255,255,255,0.04);color:var(--text)}
.rp .it.ac{
  border-left:2px solid var(--accent);background:rgba(217,119,6,0.06);
  color:var(--text);padding-left:8px;
}
.rp .it .x{
  opacity:0.6;color:var(--danger);cursor:pointer;font-size:14px;
  padding:2px 6px;border-radius:3px;transition:all 0.15s;
}
.rp .it .x:hover{opacity:1;background:var(--danger);color:var(--text)}
.rp .ar{display:flex;gap:4px;padding:4px 0}
.rp .ar input{
  flex:1;padding:5px 8px;background:var(--bg);color:var(--text);
  border:1px solid var(--border);border-radius:5px;font-size:10px;
}
.rp .ar input:focus{border-color:var(--accent);outline:none}
.rp .ar button{
  padding:5px 10px;font-size:10px;background:var(--card);color:var(--text);
  border:1px solid var(--border);border-radius:5px;cursor:pointer;font-weight:500;
}
.rp .ar button:hover{border-color:var(--accent)}

/* ==== Left Panel 统一布局 ==== */
#lp-panel input,#lp-panel select{height:24px;padding:0 8px;font-size:11px}
#lp-panel input[type=color]{width:28px;height:28px;padding:2px;flex:none}
#lp-panel .lph{display:flex;align-items:center;justify-content:space-between;gap:8px}
#lp-panel .lph h3{margin-bottom:0}
#lp-panel .hbtns{display:flex;gap:4px;align-items:center}
#lp-panel .hbtn{
  height:22px;padding:0 8px;font-size:10px;background:var(--card);color:var(--text);
  border:1px solid var(--border);border-radius:4px;cursor:pointer;font-weight:500;
  transition:all 0.15s;
}
#lp-panel .hbtn:hover{border-color:var(--accent);background:#33302c}
#lp-panel .stepbtn{
  width:24px;height:24px;padding:0;font-size:14px;line-height:1;flex:none;
  background:var(--card);color:var(--text);border:1px solid var(--border);
  border-radius:4px;cursor:pointer;transition:all 0.15s;
}
#lp-panel .stepbtn:hover{border-color:var(--accent);background:#33302c}
#lp-panel .lprow{display:flex;align-items:center;gap:6px;margin-bottom:6px}
#lp-panel .lprow:last-child{margin-bottom:0}
#lp-panel .lprow label{font-size:10px;color:var(--dim);white-space:nowrap;margin:0;min-width:30px}
#lp-panel .lprow select,#lp-panel .lprow input[type=number]{flex:1;min-width:0}
#lp-panel .lprow input[type=number]{width:auto}
#lp-panel .lpbtn{
  flex:1;height:24px;padding:0 6px;font-size:10px;background:var(--card);color:var(--text);
  border:1px solid var(--border);border-radius:4px;cursor:pointer;font-weight:500;
  transition:all 0.15s;
}
#lp-panel .lpbtn:hover{border-color:var(--accent);background:#33302c}
#lp-panel .lpcta{
  width:100%;height:28px;border-radius:6px;border:1px solid var(--accent);
  background:rgba(217,119,6,0.15);color:var(--accent);cursor:pointer;
  font-size:11px;font-weight:600;transition:all 0.15s;
}
#lp-panel .lpcta:hover{background:rgba(217,119,6,0.25)}
#lp-panel .pat-preview{
  height:56px;margin-bottom:6px;border-radius:6px;border:2px dashed var(--border);
  background:var(--bg);position:relative;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
}
#lp-panel .pat-preview .pp-name{
  position:absolute;top:3px;left:6px;font-size:9px;color:var(--dim);
  background:rgba(0,0,0,0.45);padding:1px 6px;border-radius:3px;pointer-events:none;
}
#lp-panel .ratio-card{
  width:100%;display:block;padding:8px 10px;margin-bottom:8px;
  background:var(--card);border:1px solid var(--border);border-radius:6px;
  cursor:pointer;transition:all 0.15s;text-align:left;font-weight:500;color:var(--text);
}
#lp-panel .ratio-card:hover{border-color:var(--accent);background:#33302c}
#lp-panel .ratio-card .rc-mainrow{display:flex;align-items:center;justify-content:space-between;gap:8px}
#lp-panel .ratio-card .rc-main{font-size:13px;font-weight:600;line-height:1.3}
#lp-panel .ratio-card .rc-sub{font-size:9px;color:var(--dim);line-height:1.35;margin-top:2px;font-weight:400}
#ratioPanel button{
  height:26px;padding:0 12px;background:var(--card);color:var(--text);
  border:1px solid var(--border);border-radius:4px;cursor:pointer;font-size:11px;font-weight:500;
  transition:all 0.15s;
}
#ratioPanel button:hover{border-color:var(--accent);background:#33302c}
#ratioPanel .rp-close{width:100%;margin-top:10px}

/* ==== Toast & Info ==== */
.toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
  background:var(--success);color:var(--text);padding:10px 24px;
  border-radius:8px;font-size:12px;font-weight:500;z-index:999;
  opacity:0;transition:opacity 0.3s;box-shadow:0 4px 24px rgba(0,0,0,0.5);
}
.toast.show{opacity:1}

@font-face{font-family:"Press Start 2P";src:url("/static/fonts/PressStart2P.woff2") format("woff2")}
@font-face{font-family:"VT323";src:url("/static/fonts/VT323.woff2") format("woff2")}
@font-face{font-family:"Russo One";src:url("/static/fonts/RussoOne.woff2") format("woff2")}

.btb{position:fixed;display:flex;align-items:center;gap:6px;height:34px;z-index:30;pointer-events:auto;background:var(--panel);border:1px solid rgba(255,255,255,0.06);border-radius:6px;padding:0 8px}
.btb>*{pointer-events:auto}
.btb button{height:28px;background:transparent;color:var(--text);border:none;padding:0 8px;font-size:14px;cursor:pointer;font-weight:500;transition:all 0.15s}
.btb button:hover{color:var(--accent)}
.btb span{font-size:11px;font-weight:600;min-width:24px;text-align:center;user-select:none}
#pmList button:hover{opacity:0.8}

.lib-item{display:flex;align-items:center;gap:12px;padding:8px 12px;margin:4px 0;border-radius:10px;border:2px dashed var(--border);cursor:grab;background:var(--card);transition:all 0.15s}
.lib-item:hover{border-color:var(--accent);background:#33302c;transform:translateY(-1px)}
.lib-item:active{cursor:grabbing}
.lib-ic{width:40px;height:40px;border-radius:10px;background:rgba(255,255,255,0.07);display:flex;align-items:center;justify-content:center;flex:none}
.lib-ic svg{width:22px;height:22px;display:block;color:var(--text)}
.lib-tx{flex:1;min-width:0}
.lib-name{font-size:13px;font-weight:600;line-height:1.3}
.lib-desc{font-size:11px;color:var(--dim);line-height:1.35;margin-top:1px}
/* ==== Animations ==== */
.modal{animation:mfIn .16s ease}
.modal .mcard{animation:mcIn .22s cubic-bezier(.2,.9,.3,1.15)}
.modal.m-out{animation:mfOut .15s ease forwards}
.modal.m-out .mcard{animation:mcOut .15s ease forwards}
@keyframes mfIn{from{opacity:0}}
@keyframes mfOut{to{opacity:0}}
@keyframes mcIn{from{opacity:0;transform:scale(.94)}}
@keyframes mcOut{to{opacity:0;transform:scale(.95)}}
#ratioPanel{animation:rpIn .2s ease}
#ratioPanel.rp-out{animation:rpOut .15s ease forwards}
@keyframes rpIn{from{opacity:0;transform:translateY(-6px)}}
@keyframes rpOut{to{opacity:0;transform:translateY(-4px)}}
.rp-fade{animation:rpFade .18s ease}
@keyframes rpFade{from{opacity:0;transform:translateY(3px)}}
</style></head>
<body>
<div class="main">
<div class="rp" id="lp-panel">
<div class="rp-topbar"><div class="rp-trow"><svg viewBox="0 0 1024 1024" width="22" height="22" fill="currentColor" aria-hidden="true"><rect x="365" y="238" width="34" height="29" rx="14.5"/><rect x="495" y="238" width="34" height="29" rx="14.5"/><rect x="625" y="238" width="34" height="29" rx="14.5"/><rect x="236" y="367" width="33" height="31" rx="15.5"/><rect x="367" y="367" width="33" height="31" rx="15.5"/><rect x="494" y="367" width="33" height="31" rx="15.5"/><rect x="626" y="367" width="33" height="31" rx="15.5"/><rect x="755" y="367" width="33" height="31" rx="15.5"/><rect x="236" y="495" width="33" height="34" rx="17"/><rect x="364" y="495" width="33" height="34" rx="17"/><rect x="489" y="495" width="33" height="34" rx="17"/><rect x="624" y="495" width="33" height="34" rx="17"/><rect x="755" y="495" width="33" height="34" rx="17"/><rect x="236" y="626" width="33" height="31" rx="15.5"/><rect x="367" y="626" width="33" height="31" rx="15.5"/><rect x="494" y="626" width="33" height="31" rx="15.5"/><rect x="626" y="626" width="33" height="31" rx="15.5"/><rect x="755" y="626" width="33" height="31" rx="15.5"/><rect x="365" y="757" width="34" height="29" rx="14.5"/><rect x="495" y="757" width="34" height="29" rx="14.5"/><rect x="625" y="757" width="34" height="29" rx="14.5"/></svg><h1>Tapflow</h1><span class="conn off" id="cs">off</span></div><button class="btn-save" id="btnSave" onclick="saveProfile()">Save &amp; Sync</button></div>
<div id="pl" style="display:none"></div>
      <div class="rp-section" id="rp-profiles-sec">
        <div class="lph"><h3>Profiles</h3><div class="hbtns"><button class="hbtn" onclick="pmImport()" title="Import Profile from File">Import</button><button class="hbtn" onclick="pmExportDialog()" title="Export Profile">Export</button><button class="hbtn" onclick="pmCreate()" title="New Profile">+ New</button></div></div><input type="file" id="pmImpF" accept=".json,application/json" style="display:none" onchange="pmImportGo(this)">
        <div id="profList"></div>
      </div>
      <div class="rp-divider"></div>
      <div class="rp-section" id="rp-ratio-sec">
        <h3>Display Scale</h3>
        <button class="ratio-card" id="ratioCard" onclick="toggleRatioPanel()" title="Change display scale">
          <span class="rc-mainrow">
            <span class="rc-main" id="ratioName">—</span>
          </span>
          <span class="rc-sub" id="ratioDetail" style="display:block"></span>
        </button>
        <div id="ratioPanel" style="display:none">
          <p id="ratioModalInfo" style="color:var(--dim);font-size:10px;margin:0 0 8px"></p>
          <div id="ratioModalPresets" style="display:flex;flex-wrap:wrap;gap:6px"></div>
          <div style="display:flex;align-items:center;gap:6px;margin-top:10px"><label style="font-size:10px;color:var(--dim);white-space:nowrap;min-width:48px">Title Bar</label><input type="number" id="topInsetIn" min="0" max="300" step="1" value="0" onchange="upkTopInset(this.value)" title="Top safe-area / title bar height to mark off in the frame (logical px)" style="flex:1;min-width:0;height:24px;padding:0 8px;font-size:11px;background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:4px"><span style="font-size:10px;color:var(--dim)">px</span></div>
          <div style="display:flex;gap:6px;margin-top:10px"><button onclick="applyCustomRatio()" style="flex:1">Custom pixels…</button><button onclick="toggleOri()" title="Toggle Orientation" style="flex:1">⟳ Rotate</button></div>
          <button onclick="closeRatioModal()" class="rp-close">Hide</button>
        </div>
      </div>
      <div class="rp-section">
        <h3 id="pp-heading">Page Style</h3>
        <div class="lprow"><label>BG</label><input type="color" id="pageBg" value="#1a1a2e" oninput="upkPageBg(this.value)" onchange="upkPageBg(this.value)" title="Page background color"></div>
        <div class="lprow"><label>Pat</label><select id="pagePat" onchange="upkPagePattern(this.value)" title="Background pattern"><option value="none">No Pattern</option><option value="topography">Topography</option><option value="circuit">Circuit</option><option value="dots">Dots</option><option value="diagonal">Diagonal</option><option value="hexagon">Hexagon</option><option value="grid">Grid</option><option value="triangles">Triangles</option><option value="topo">Topo Texture</option><option value="waves">Waves</option></select><input type="color" id="pagePatColor" value="#ffffff" oninput="upkPagePatternColor(this.value)" onchange="upkPagePatternColor(this.value)" title="Pattern color"></div>
